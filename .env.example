# ─────────────────────────────────────────────────────
# Q-Smart — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ─────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────
# Disponibles dans : supabase.com → Projet → Settings → API
PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...votre_anon_key...

# ⚠️  Ne jamais exposer côté client !
SUPABASE_SERVICE_ROLE_KEY=eyJ...votre_service_role_key...

# ── Web Push (notifications) ──────────────────────────
# Générer avec : npx web-push generate-vapid-keys
PUBLIC_VAPID_KEY=BVotre_cle_publique_vapid...
VAPID_PRIVATE_KEY=votre_cle_privee_vapid...
VAPID_EMAIL=mailto:admin@votre-domaine.com

# ── Serveur ───────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
